# Servidor
PORT=3001
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma (Next.js cambia de
# puerto en dev según cuál esté libre: 3000, 3002, etc.). Si no se
# configura, cae a FRONTEND_URL como único origen.
# En producción debe ser exactamente UN dominio real (sin localhost ni
# 127.0.0.1) — el servidor rechaza arrancar si no se cumple (ver
# src/config/env.ts).
FRONTEND_URLS=http://localhost:3000,http://localhost:3002

# Base de datos (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plataforma_documentos

# Autenticación
# En producción, JWT_SECRET no puede quedar en este valor placeholder ni
# tener menos de 32 caracteres — el servidor rechaza arrancar si NODE_ENV=production
# y no se cambió (ver src/config/env.ts).
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
# Access token de vida corta (se revalida seguido vía /auth/refresh).
JWT_EXPIRES_IN=15m
# Refresh token de vida larga, guardado hasheado en la tabla refresh_tokens
# (nunca en texto plano) — revocable individualmente o todos a la vez.
REFRESH_TOKEN_EXPIRES_IN=30d

# Job de alarmas (src/jobs/check-alerts.ts): cada cuánto revisa vencimientos
# de examen médico/calibración/eventos programados, en milisegundos.
# Opcional — si no se define, corre cada hora (3600000 ms).
CHECK_ALERTS_INTERVAL_MS=3600000

# Almacenamiento de archivos (S3 compatible: AWS S3, Cloudflare R2, MinIO, etc.)
#
# Para desarrollo local: `docker compose up -d minio minio-init` levanta un
# MinIO con el bucket ya creado y estas credenciales de desarrollo fijas
# (ver README.md, sección "Almacenamiento de archivos (S3/MinIO)"). Usa este
# bloque y comenta el de producción/staging de abajo:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=plataforma-documentos
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000/plataforma-documentos

# Producción/staging: AWS S3, Cloudflare R2, o cualquier otro proveedor real.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=plataforma-documentos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública (o dominio propio) desde donde se sirven los archivos subidos
S3_PUBLIC_URL=https://files.tudominio.com
